{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loom",
  "version": "1.0.0",
  "identifier": "wtf.fall.loom",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Loom",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 680,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#f3f4f6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "Loom"
}
